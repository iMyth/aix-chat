# ─────────────────────────────────────────────────────────────────────
# Server configuration — read by packages/server (loaded from this path by
# src/env.ts, regardless of the directory you start the server from).
#
# Frontend variables do NOT go here: the demo is a separate Vite app and
# reads packages/demo/.env. See README.md → Configuration.
# Copy this file to .env and fill in the values:
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────

# AI provider — any OpenAI-compatible endpoint, DashScope (Qwen) by default.
# Required: without it the server starts but every chat request fails.
DASHSCOPE_API_KEY=your-dashscope-api-key

# Model name passed to the provider.
TEXT_MODEL=qwen3.6-plus

# Base URL of the OpenAI-compatible API.
# e.g. OpenAI: https://api.openai.com/v1 | Ollama: http://localhost:11434/v1
OPENAI_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Database (PostgreSQL via Docker) — this default matches docker-compose.yml.
# The server exits at startup if it cannot connect.
DATABASE_URL=postgresql://aix:aix123@localhost:5432/aix_chat

# Backend HTTP port.
PORT=3000