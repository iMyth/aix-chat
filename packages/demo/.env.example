# Frontend configuration for the demo app (this file sits next to the Vite
# project, which is where Vite looks for VITE_* variables).
#
# Optional: sent to the backend as the `x-api-key` request header
# (see src/App.vue). The bundled template server does not verify it — it only
# reads `x-user-id`. Replace it with your own auth scheme when wiring up a real
# backend; keep the value out of git.
VITE_API_KEY=your-api-key